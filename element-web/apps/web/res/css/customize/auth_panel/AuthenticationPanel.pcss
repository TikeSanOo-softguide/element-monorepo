/* =========================================================
   NORMAL MOBILE (376px - 599px)
   Targeting:
   - 414px × 896px Portrait
   ========================================================= */

@media screen and (min-width: 376px) and (max-width: 599px) {
    .mx_Welcome {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-inline: auto !important;
        padding: 0 !important;
    }

    .mx_DefaultWelcome {
        width: 100% !important;
        margin: 0 auto !important;
        padding: 18px 36px !important;
        box-sizing: border-box !important;
    }

    .mx_DefaultWelcome_logo img {
        width: 100px !important;
        height: 100px !important;
    }

    .mx_DefaultWelcome_buttons a {
        width: 100% !important;
    }

    .mx_AuthPage_modal {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 10px 20px !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }

    .mx_AuthPage_modalContent {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
    }

    .mx_AuthPage_modal .mx_AuthHeaderLogo {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin: 0 auto 4px auto !important;
        padding: 0 !important;
    }

    .mx_AuthPage_modal .mx_AuthHeaderLogo img {
        width: 100px !important;
        height: 100px !important;
    }

    .mx_AuthPage_modal .mx_AuthHeader {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .mx_AuthBody_forgot-password {
        width: 100% !important;
        padding: 12px 22px !important;
        height: auto !important;
        min-height: 0 !important;
        box-sizing: border-box !important;
    }

    .mx_AuthBody {
        width: 100% !important;
        max-width: 420px !important;
        margin-inline: auto !important;
        padding: 5px 24px !important;
        box-sizing: border-box !important;
    }

    .mx_Register_mainContent {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    .mx_Field.mx_Field_select {
        max-width: 140px !important;
    }

    .mx_Field_select select,
    select#mx_Field_2,
    select#mx_Field_6 {
        width: 100% !important;
        font-size: 11px !important;
    }

    .mx_ServerPicker_helpDialog .mx_Dialog_content,
    .mx_Dialog_border,
    .mx_ServerPickerDialog,
    .mx_EncryptionCard.mx_EncryptionCard_noBorder,
    .mx_InteractiveAuthEntryComponents_passwordSection {
        width: 100% !important;
        box-sizing: border-box !important;
    }
}


/* =========================================================
   SMALL PHONE (320px - 375px)
   Targeting:
   - 320px × 568px Portrait
   ========================================================= */

@media screen and (min-width: 320px) and (max-width: 375px) {
    .mx_Welcome {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-inline: auto !important;
        padding: 0 !important;
    }

    .mx_DefaultWelcome {
        width: 100% !important;
        margin: 0 auto !important;
        padding: 2px 36px !important;
        box-sizing: border-box !important;
    }

    .mx_DefaultWelcome_logo img {
        width: 60px !important;
        height: 60px !important;
    }

    .mx_DefaultWelcome_buttons a {
        width: 100% !important;
    }

    .mx_DefaultWelcome h1 {
        font-size: 16px !important;
    }

    .mx_AuthPage_modal {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 10px 20px !important;
        width: 100% !important;
        box-sizing: border-box !important;
        max-height: 100vh !important;
    }

    .mx_AuthPage_modalContent {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
    }

    .mx_AuthPage_modal .mx_AuthHeaderLogo {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin: 0 auto 4px auto !important;
        padding: 0 !important;
    }

    .mx_AuthPage_modal .mx_AuthHeaderLogo img {
        width: 70px !important;
        height: 70px !important;
    }

    .mx_AuthPage_modal .mx_AuthHeader {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        margin-bottom: 2px !important;
    }

    .mx_AuthBody_forgot-password {
        width: 100% !important;
        padding: 12px 22px !important;
        height: auto !important;
        min-height: 0 !important;
        box-sizing: border-box !important;
    }

    .mx_AuthBody {
        width: 100% !important;
        max-width: 380px !important;
        margin-inline: auto !important;
        padding: 2px 12px !important;
        box-sizing: border-box !important;
    }

    .mx_AuthBody h1 {
        font-size: 20px !important;
        margin-bottom: 4px !important;
        margin-top: 0px !important;
    }

    .mx_ServerPicker {
        margin-bottom: 4px !important;
        font-size: 12px !important;
    }

    .mx_AuthBody form .mx_Field {
        margin-bottom: 8px !important;
    }

    .mx_AuthBody form .mx_Field.mx_Field_input, 
    .mx_AuthBody form .mx_Field.mx_Field_select {
        height: 36px !important;
        min-height: 36px !important;
    }

    .mx_AuthBody form .mx_Field_input input, 
    .mx_AuthBody form .mx_Field_select select {
        height: 34px !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        font-size: 12px !important;
    }

    .mx_InteractiveAuthEntryComponents_passwordSection .mx_Field_input input {
        height: 30px !important;
    }

    .mx_AuthBody form .mx_Login_submit {
        height: 38px !important;
        margin-top: 4px !important;
        margin-bottom: 4px !important;
        padding: 6px !important;
    }
    
    .mx_AuthBody .mx_AuthBody_changeFlow {
        font-size: 11px !important;
    }

    .mx_Register_mainContent {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    .mx_Field.mx_Field_select {
        max-width: 140px !important;
    }

    .mx_Field_select select,
    select#mx_Field_2,
    select#mx_Field_6 {
        width: 100% !important;
        font-size: 11px !important;
    }

    .mx_ServerPicker_helpDialog .mx_Dialog_content,
    .mx_Dialog_border,
    .mx_ServerPickerDialog,
    .mx_EncryptionCard.mx_EncryptionCard_noBorder,
    .mx_InteractiveAuthEntryComponents_passwordSection {
        width: 100% !important;
        box-sizing: border-box !important;
    }
}


