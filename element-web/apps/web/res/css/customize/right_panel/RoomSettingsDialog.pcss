@media (max-width: 1035px) {
    .mx_RoomSettingsDialog {
        width: 85vw;

        .mx_AutoHideScrollbar.mx_TabbedView_tabPanelContent {
            overflow-x: hidden;
        }
    }
}

@media (max-width: 840px) {
    .mx_RoomSettingsDialog {
        .mx_TabbedView .mx_SettingsTab {
            min-width: 490px;
        }
    }

    .mx_RoomProfileSettings {
        .mx_RoomProfileSettings_profile {
            flex-direction: column-reverse;

            .mx_RoomProfileSettings_profile_controls {
                width: 100%
            }
        }
    }
}

@media (max-width: 820px) {
    .mx_RoomSettingsDialog .mx_AdvancedSettingsCopyableText {
        width: 90%;
        overflow-wrap: anywhere;
        word-break: break-all;
    }
}

@media (max-width: 767px) {
    .mx_RoomSettingsDialog {
        width: 70vw;

        .mx_Dialog_title {
            padding-right: 0;
        }

        .mx_TabbedView_tabsOnLeft {
            width: 85%;

            .mx_TabbedView_tabLabels {
                width: 85%;
                max-width: none;
            }

            .mx_TabbedView_tabPanel {
                margin-left: 7px;

                .mx_SettingsTab {
                    min-width: 0;
                    margin-left: 0;
                    padding-right: 0;
                }
            }
        }
    }

    .mx_NotificationSettingsTab_notificationsSection {
        width: 100%;

        .mx_StyledRadioButton_content {
            margin-left: 0;
        }

        .mx_StyledRadioButton_spacer {
            display: none;
        }
    }

    .mx_ManageRestrictedJoinRuleDialog {
        width: 65vw;

        .mx_ManageRestrictedJoinRuleDialog_footer_buttons {
            margin-left: 0;
        }
    }

    .mx_ForwardDialog {
        width: 70vw;
    }

    .mx_UnpinAllDialog {
        max-width: 100%;
    }

    .mx_PollHistoryList_list {
        width: 90%;
    }
}

@media (max-width: 535px) {
    .mx_RoomSettingsDialog {
        .mx_TabbedView_tabsOnLeft {
            width: 80%;

            .mx_TabbedView_tabLabels {
                width: 80%;
            }
        }
    }
    
    .mx_BulkRedactDialog, 
    .mx_UserInfoKickDialog, 
    .mx_UserInfoBanDialog, 
    .mx_UserInfoDeactivateDialog {
        width: 70vw;

        .mx_Dialog_buttons {
            .mx_Dialog_buttons_row {
                button {
                    min-width: 0;
                    padding: 7px 10px;
                }
            }
        }
    }
}